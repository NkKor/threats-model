# Конфигурация сервиса «Генератор моделей угроз ФСТЭК».
# Скопируйте файл в .env и при необходимости измените значения:
#   cp .env.example .env

# Основные настройки
APP_NAME="Threat Modeler FSTEC"
APP_PORT=8080
# development | production | testing
ENV=development

# База данных SQLite (путь относительно каталога threat-modeler).
# В базе хранятся только справочники и корпус УБИ: данные опроса и отчёты
# в неё не записываются.
DB_PATH=./data/threats.db

# Каталоги (DATA_DIR содержит справочники, seed и файл правил report-rules.txt)
DATA_DIR=./data

# Ключ подписи cookie-сессии. ОБЯЗАТЕЛЬНО задайте в production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-production
# Время жизни cookie-сессии, секунды. 0 — сессионная cookie: данные опроса
# исчезают при закрытии браузера (данные компании на сервере не хранятся).
SESSION_MAX_AGE=0

# Источники CORS через запятую. Пусто = только same-origin (рекомендуется).
CORS_ORIGINS=

# Загружать канонические данные при старте, если БД пуста
SEED_ON_STARTUP=true

# Логирование SQL-запросов (для отладки)
DB_ECHO=false

# Трактовка правил корреляции (см. app/core/correlation.py)
# R3: capability — нарушитель реализует угрозы своего уровня и ниже (по умолчанию);
#     strict — уровень нарушителя должен быть явно указан у угрозы.
LEVEL_SEMANTICS=capability
# R5: keep — УБИ без определённых видов воздействия не ограничиваются (по умолчанию);
#     exclude — такие УБИ исключаются.
IMPACTS_SEMANTICS=keep
